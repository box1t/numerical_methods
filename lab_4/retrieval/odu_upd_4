def getTrueY_4th_derivative(x):
    """
    Calculates the 4th derivative of the true solution y(x) = x + 1 + exp(x).
    y'(x) = 1 + exp(x)
    y''(x) = exp(x)
    y'''(x) = exp(x)
    y^(4)(x) = exp(x)
    """
    return np.exp(x)

