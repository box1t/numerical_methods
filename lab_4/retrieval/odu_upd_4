def calculate_max_absolute_error(xs_vals, ys_vals):
    """
    Вычисляет максимальную абсолютную ошибку численного решения
    по сравнению с истинным решением на заданных точках.
    """
    max_error = 0
    for i in range(len(xs_vals)):
        true_y = getTrueY(xs_vals[i])
        # Сравниваем только первую компоненту вектора решения
        current_error = abs(ys_vals[i][0] - true_y)
        if current_error > max_error:
            max_error = current_error
    return max_error

