def calculate_jacobian_eigenvalues(x_val):
    """
    Вычисляет матрицу Якоби и ее собственные значения для данной системы ОДУ.
    Для системы y' = f(x, y), где f(x, y) = [y[1], ((x + 1) * y[1] - y[0]) / x]
    Матрица Якоби J = df/dy:
    J = | df0/dy0   df0/dy1 | = | 0             1           |
        | df1/dy0   df1/dy1 |   | -1/x    (x + 1)/x   |
    """
    
    jacobian_matrix = np.array([
        [0, 1],
        [-1/x_val, (x_val + 1)/x_val]
    ])
    
    eigenvalues = np.linalg.eigvals(jacobian_matrix)
    return eigenvalues

